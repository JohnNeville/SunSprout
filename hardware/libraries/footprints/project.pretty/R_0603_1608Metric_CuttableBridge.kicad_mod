(footprint "R_0603_1608Metric_CuttableBridge"
	(version 20260206)
	(generator "kicad-footprint-generator")
	(layer "F.Cu")
	(descr "Resistor SMD 0603 (1608 Metric) with a normally-closed cuttable copper bridge between the two pads. Ships shorted (0 ohm equivalent) with no part placed; cut the 0.3mm bridge through the soldermask window to open the link, then hand-solder a 0603 resistor if a real value is needed. Declared as a net tie so DRC accepts the deliberate short. Based on Resistor_SMD:R_0603_1608Metric (IPC-7351 nominal).")
