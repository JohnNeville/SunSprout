		(property "Usage" "PMID high-frequency decoupling (the priority-1 close-to-pin 0.1uF cap for this net, paired with bulk cap C304)."
			(at 152.4 335.28 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Placement" "TI SS8.4.1 priority 1 (highest): place on the same PCB layer as the IC, on top of it, with a short trace to the PMID and GND pins -- critical for noise filtering. C304 is the bulk cap the spec requires be placed in parallel with this 0.1uF cap. Per SS8.4.2, this tight pairing generally forces the SW1/SW2-to-inductor traces onto a different PCB layer."
			(at 152.4 335.28 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
