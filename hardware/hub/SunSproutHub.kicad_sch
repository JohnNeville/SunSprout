		)
		(property "Usage" "Low-side battery current-sense (shunt) resistor for BQ34Z100PWR-G1's SRP/SRN coulomb counter. Sits in series between the true battery negative terminal (J4 pin 2) and system GND -- full battery charge/discharge current flows through this discrete part, not through the gauge IC's own pins."
			(at 151.13 276.86 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Placement" "TI BQ34Z100 Fig 8-2 reference (R30): place close to the battery connector, in the direct battery-return path. SRP/SRN should Kelvin-sense directly at this resistor's own two pads for accurate coulomb counting -- route SRP/SRN traces separately from the main high-current return path."
			(at 151.13 276.86 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
